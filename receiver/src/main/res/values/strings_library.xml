<?xml version="1.0" encoding="utf-8"?>
<!-- The TV library screens: the phone's video library browsed on the TV (docs/design/library-channel.md).
     Mono labels (eyebrows, chips, counts) render in a style that applies no case transform, so
     their copy arrives uppercase. -->
<resources>
    <!-- Top bar -->
    <string name="libui_tab_home">Home</string>
    <string name="libui_tab_shows">Shows</string>
    <string name="libui_tab_films">Films</string>
    <string name="libui_tab_all">All videos</string>
    <string name="libui_search">Search</string>
    <string name="libui_settings">Settings</string>
    <!-- Spoken for the phone pill, which opens Refresh and Pair another phone. -->
    <string name="libui_phone_menu_a11y">%1$s. Library options</string>
    <string name="libui_refresh">Refresh library</string>
    <string name="libui_pair_another">Pair another phone</string>
    <string name="libui_phone_fallback">your phone</string>
    <plurals name="libui_video_count">
        <item quantity="one">%1$s VIDEO</item>
        <item quantity="other">%1$s VIDEOS</item>
    </plurals>
    <!-- Calm, not alarming: the catalog stays on screen and browsable while it shows. -->
    <string name="libui_reconnecting">Reconnecting to %1$s…</string>
    <string name="libui_reconnecting_short">RECONNECTING…</string>

