<resources>
    <string name="app_name">Flick</string>
    <string name="brand_wordmark">flick</string>
    <!-- Lockup eyebrow on the pair and idle screens: "RECEIVER · LIVING ROOM TV". -->
    <string name="receiver_eyebrow">RECEIVER · %1$s</string>

    <!-- T1 · First-run pair -->
    <string name="pair_title">Scan to flick\nfrom your phone.</string>
    <string name="pair_instructions">Open Flick, tap Devices, and point your camera at the code. Everything stays on your Wi-Fi.</string>
    <!-- The one word inside pair_instructions that renders in the amber accent. -->
    <string name="pair_instructions_highlight">Flick</string>
    <string name="pair_rename">Rename TV</string>
    <!-- Its own label rather than idle_settings: the same word on two screens, but a
         shared string couples them, and one of them being re-worded would silently
         re-word the other. With nothing paired the TV routes here and never to Idle,
         so this is the only way into Settings on a factory-fresh device. -->
    <string name="pair_settings">Settings</string>
    <string name="pair_qr_content_description">QR code for pairing this TV with Flick on your phone</string>
    <!-- Manual-entry escape hatch when the QR can\'t be scanned / discovery fails. -->
    <string name="pair_manual_eyebrow">OR ADD THIS TV BY HAND</string>
    <string name="pair_manual_ip_label">IP address</string>
    <string name="pair_manual_port_label">Port</string>
    <string name="pair_manual_code_label">Pairing code</string>
    <!-- Shown when PairingManager exposes no remaining TTL — never invent a countdown. -->
    <string name="pair_one_sender">One sender at a time</string>
    <!-- Only when a real remaining-TTL value exists; %1$s is a m:ss timer. -->
    <!-- Rendered uppercase in tracked mono, so it must stay short enough for one
         line inside the manual-entry card — see PairColumnItemGap. -->
    <string name="pair_code_rotates">Code rotates in %1$s · one sender</string>
    <string name="pair_listening">Listening · no account, nothing uploaded</string>
    <string name="pair_url">flick://%1$s:%2$d</string>
    <!-- Low-emphasis bind health, so a stale port reads differently from a wrong code. -->
    <string name="pair_bind_health">link up %1$ds · %2$d rebinds</string>
    <string name="pair_bind_last_teardown">last: %1$s</string>
    <!-- Must hold ONE line at 24 sp inside the manual-entry card: this replaces the
         timer row, and a second line overflows the pair column's vertical budget
         (see PairColumnItemGap) and crushes the action row's labels. -->
    <string name="pair_locked">Pairing locked — try again shortly.</string>
    <!-- The cumulative-failure seal, distinct from the timed lockout above: that one
         clears itself, this one does not. The copy has to say so, or a user who mistyped
         waits for a countdown that never comes and reads the TV as broken. It names the
         reason the way out is a button on the television — the point of the ceiling is
         that guessing ends needing someone in the room — and deliberately quotes no
         attempt count, which would be both an oracle and a number that drifts. -->
    <string name="pair_sealed_title">Pairing paused</string>
    <string name="pair_sealed_body">Too many wrong codes were entered. Pairing stays closed until it is resumed here on the TV, so a phone that isn\'t in this room can\'t keep guessing.</string>
    <string name="pair_sealed_resume">Resume pairing</string>
    <string name="pair_success">Phone paired</string>
    <!-- The on-TV confirmation. It exists because the QR carries the live code, so
         anyone who can read this screen can submit a correct one — the answer to that
         is a button nobody outside this room can press. The copy names what allowing
         grants ("cast to this TV") and does not overclaim: it is not file access. It
         says the request came from THIS screen so a viewer can tell an expected
         request from an unexpected one, and it states which way the timer resolves,
         because a prompt that expires into an allow would be no gate at all. -->
    <string name="pair_confirm_title">Allow this phone?</string>
    <string name="pair_confirm_instructions">%1$s scanned the code on this screen and wants to cast here.</string>
    <string name="pair_confirm_body">Allowing lets this phone start and control videos on this TV. It gets no access to anything else, and you can remove it later in Settings.</string>
    <string name="pair_confirm_deadline">Declines automatically in %1$ds</string>
    <string name="pair_confirm_deadline_unknown">Declines automatically if nobody answers</string>
    <string name="pair_confirm_allow">Allow</string>
    <string name="pair_confirm_deny">Don\'t allow</string>
    <string name="settings_forget_all">Forget all phones</string>
    <string name="settings_forget_all_summary">Remove every paired phone from this TV</string>
    <string name="settings_forget_all_confirm">Press again to confirm</string>
    <string name="pair_waiting_network_title">Waiting for Wi-Fi…</string>
    <string name="pair_waiting_network_detail">Connect this TV to your home network to start pairing.</string>

