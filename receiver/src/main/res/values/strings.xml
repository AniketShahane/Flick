    <!--
      Picture orientation: the transport's square tile and the panel it opens. The
      degrees are the turn Flick adds to the container's own, so 0° means "exactly
      as the file says" and is what corrects an Auto that read the file wrong.
    -->
    <string name="video_rotation_panel_title">Orientation</string>
    <string name="video_rotation_close">Close orientation</string>
    <!-- The tile's eyebrow, over the degrees Auto settled on. -->
    <string name="video_rotation_card_auto">AUTO</string>
    <!-- Spoken, not drawn: the tile stacks the same two parts inside its square. -->
    <string name="video_rotation_card_description">Picture orientation: %1$s</string>
    <string name="video_rotation_auto">Auto</string>
    <string name="video_rotation_as_filed">0°</string>
    <string name="video_rotation_quarter">90°</string>
    <string name="video_rotation_half">180°</string>
    <string name="video_rotation_three_quarter">270°</string>
    <!-- What Auto decided, e.g. "AUTO · 90°". Shown only while Auto is chosen. -->
    <string name="video_rotation_auto_applied">AUTO · %1$s</string>
    <!--
      What a turn cost, or could not do — the panel's eyebrow slot, replacing the
      Auto readout for as long as there is something to say. Only ever shown
      against a turn the viewer can see the result of, so both lines describe the
      picture rather than the mechanism behind it.
    -->
    <string name="video_rotation_note_locked">THIS TV CAN\'T TURN THIS FILM</string>
    <string name="video_rotation_note_tone_mapped">TURNED · SHOWN IN SDR</string>

    <!--
      The picture-orientation hint: two lines over the film, once per cast. The
      second line names the control by what it wears — the transport's tile carries
      exactly these degrees — because a viewer whose film is sideways is looking at
      the picture, not for the name of a panel.
    -->
    <string name="orientation_hint_turned_title">Turned this film upright</string>
    <string name="orientation_hint_turned_where">CHANGE IT ON THE %1$s TILE</string>
    <string name="orientation_hint_as_filed_title">Showing this film as filed</string>
    <string name="orientation_hint_as_filed_where">TURN IT ON THE %1$s TILE</string>

    <!--
      The silent-audio notice: two lines over the film, once per cast. It names the
      film's audio format and stops there, because there is nothing to send the
      viewer to — no setting on this TV or that phone plays it. The second line is
      about what they are hearing, never about what could not be started.
    -->
    <string name="audio_silent_title">Playing without sound</string>
    <string name="audio_silent_reason">THIS TV CAN\'T PLAY %1$s AUDIO</string>
    <string name="audio_silent_reason_unknown">THIS TV CAN\'T PLAY THIS FILM\'S AUDIO</string>
    <!-- Spoken, not drawn: the card splits the same sentence over its two lines. -->
    <string name="audio_silent_card_description">Playing without sound. This TV can\'t play %1$s audio.</string>
    <string name="audio_silent_card_description_unknown">Playing without sound. This TV can\'t play this film\'s audio.</string>

    <!--
      The band's event notices: what just happened to this film, once per cast. None of
      these may promise a fix, so the audio one names the interruption and not an
      outcome: the sound coming back is not certain — a second refusal after the rebuild
      ends the cast, under a terminal screen this line would have contradicted. A dropped
      subtitle is not offered again either, because the rollback is one-shot. Nor may the
      subtitle line call the file broken: a cache eviction on the phone looks identical
      from here.
    -->
    <string name="notice_audio_restart_title">The sound was interrupted</string>
    <string name="notice_audio_restart_line">THIS TV IS CHANGING HOW IT PLAYS THIS FILM\'S AUDIO</string>
    <string name="notice_subtitle_dropped_title">That subtitle wouldn\'t load</string>
    <string name="notice_subtitle_dropped_line">THE FILM IS PLAYING WITHOUT IT</string>
    <!-- Spoken, not drawn: each card splits one sentence over two lines, and the second
         is set in caps for the ten-foot read rather than for a screen reader. -->
    <string name="notice_audio_restart_description">The sound was interrupted. This TV is changing how it plays this film\'s audio.</string>
    <string name="notice_subtitle_dropped_description">That subtitle wouldn\'t load. The film is playing without it.</string>
    <string name="notice_turn_unavailable_description">Showing this film as filed. This TV can\'t turn this film.</string>

