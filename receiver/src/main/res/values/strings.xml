    <!-- T9a · SENDER_NOT_SERVING (amber). The probe or the transport proved the phone was
         answering, so "battery saver paused it" was invented — and "your place is held"
         was a promise fail() cannot keep: it calls controller.stop(), which clears the
         saved position. The before-the-first-frame form lives in strings_errors.xml. -->
    <string name="error_not_serving_title">Your phone stopped serving</string>
    <string name="error_not_serving_detail">%1$s is on the network and answering, but the film stopped arriving. Start it again from your phone.</string>
    <string name="error_back_to_standby">Back to standby</string>

    <!-- T9b · PHONE_UNREACHABLE mid-film (crimson). Nothing in the receiver watches for
         the phone returning and no path re-prepares, so the shipped "playback resumes the
         moment it's back" was a promise no code keeps — under a button that ends the
         session. The before-the-first-frame form lives in strings_errors.xml. -->
    <string name="error_unreachable_title">Lost sight of your phone</string>
    <string name="error_unreachable_detail">%1$s stopped answering this TV mid-film. Nothing here resumes on its own — start it again from your phone when it\'s back.</string>
