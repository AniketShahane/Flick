<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Fullscreen, no-action-bar theme for the Compose-driven leanback Activity.
      Parented on the platform Material theme (minSdk 26) so no AppCompat/Material
      XML dependency is required — all UI is Compose.

      The window background is the lit room's canvas (#F2F4F9, FlickRoom.Canvas),
      so the first frame the compositor shows already matches the standby screens
      the app opens on.
    -->
    <style name="Theme.Flick" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">#FFF2F4F9</item>
        <item name="android:colorBackground">#FFF2F4F9</item>
        <item name="android:statusBarColor">#FFF2F4F9</item>
        <item name="android:navigationBarColor">#FFF2F4F9</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowContentOverlay">@null</item>
    </style>

    <!--
      WakeActivity: fully transparent with no window animation, so no starting
      window, splash or blank frame stands between the app that was in front and
      Flick. Not NoDisplay: that activity never gets a window, so it could neither
      turn the screen on nor take focus.
    -->
    <style name="Theme.Flick.Wake" parent="@android:style/Theme.Translucent.NoTitleBar">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:backgroundDimEnabled">false</item>
    </style>

    <!-- No window entrance (the dialog draws its own); a short fade on exit. -->
    <style name="Animation.Flick.RenameDialog" parent="">
        <item name="android:windowEnterAnimation">@null</item>
        <item name="android:windowExitAnimation">@anim/rename_dialog_window_exit</item>
    </style>
</resources>
