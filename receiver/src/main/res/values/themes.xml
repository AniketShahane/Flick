<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Fullscreen, no-action-bar theme for the Compose-driven leanback Activity.
      Parented on the platform Material theme (minSdk 26) so no AppCompat/Material
      XML dependency is required — all UI is Compose.

      The window background is the Flick "canvas" (#04070F, blue-black) — never
      pure #000, so the first frame the compositor shows already matches the app.
    -->
    <style name="Theme.Flick" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">#FF04070F</item>
        <item name="android:colorBackground">#FF04070F</item>
        <item name="android:statusBarColor">#FF04070F</item>
        <item name="android:navigationBarColor">#FF04070F</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowContentOverlay">@null</item>
    </style>
</resources>
