<?xml version="1.0" encoding="utf-8"?>
<!--
  minSdk is 26, so this -v26 qualifier always matches: every launcher that can
  install the app gets the adaptive mark. @drawable/ic_launcher stays in the tree
  as the flat fallback for tooling paths that resolve a plain drawable.

  The full-bleed background deliberately leaves the outline to the launcher, so
  Flick follows circle, squircle, rounded-square, square, and OEM masks such as
  Samsung One UI without a smaller shape baked into the artwork. The colour and
  monochrome marks remain inside the central 66-unit safe zone; the system masks
  and re-tints <monochrome> itself.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
    <monochrome android:drawable="@drawable/ic_launcher_monochrome" />
</adaptive-icon>
