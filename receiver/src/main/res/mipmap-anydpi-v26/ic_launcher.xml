<?xml version="1.0" encoding="utf-8"?>
<!--
  minSdk is 26, so this -v26 qualifier always matches: every launcher that can
  install the app gets the adaptive mark. @drawable/ic_launcher stays in the tree
  as the flat fallback for tooling paths that resolve a plain drawable.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
    <monochrome android:drawable="@drawable/ic_launcher_foreground" />
</adaptive-icon>
