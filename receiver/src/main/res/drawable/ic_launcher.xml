<?xml version="1.0" encoding="utf-8"?>
<!--
  Flick launcher icon, flat form: the pre-adaptive fallback for tooling paths that
  resolve a plain drawable. minSdk is 26, so mipmap-anydpi-v26/ic_launcher always
  matches on-device and nothing on a real launcher reaches this file.

  It is now the adaptive icon's two layers stacked rather than its own copy of the
  geometry: same disc, same mark, and it cannot drift out of step the way a second
  transcription of the 64-unit grid could. The circle comes with it — a fallback
  that stayed a full-bleed square would be the one place Flick is not round.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@drawable/ic_launcher_disc" />
    <item android:drawable="@drawable/ic_launcher_foreground" />
</layer-list>
