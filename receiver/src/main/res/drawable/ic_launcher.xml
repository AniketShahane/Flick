<?xml version="1.0" encoding="utf-8"?>
<!--
  Flick launcher icon, flat form: the pre-adaptive fallback for tooling paths that
  resolve a plain drawable. minSdk is 26, so mipmap-anydpi-v26/ic_launcher always
  matches on-device and nothing on a real launcher reaches this file.

  It stacks the same full-bleed colour and foreground used by the adaptive icon,
  rather than maintaining a second copy of the mark. No launcher mask is baked
  into this fallback; mask ownership stays with adaptive launchers.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/ic_launcher_background" />
    <item android:drawable="@drawable/ic_launcher_foreground" />
</layer-list>
