<?xml version="1.0" encoding="utf-8"?>
<!--
  Adaptive-icon foreground: the Flick mark alone on the 108-unit canvas. The
  themed icon is ic_launcher_monochrome, not this file — the launcher keeps a
  monochrome layer's alpha, and the streaks below are deliberately translucent.

  The group maps the 64-unit grid to (54,54): p -> 0.8307292p + 27.4166667, so
  the grid centre (32,32) lands on the canvas centre. The scale is the former
  0.90625 stepped down by 33/36, the same ratio the disc took, so the mark keeps
  exactly the proportion it held against r=36 — 0.7177 of the radius. This icon
  is the drawing it always was, 8.3% smaller with its disc; :sender's mark was
  rescaled to match it, since that proportion is the one that reads.

  The extreme is the triangle's right tip. The outline below is the outset shape
  drawn out by hand, so its tip arc centres on 56.01 rather than the vertex's
  exact 56: 19.946 from centre, plus the 4.5-unit outset scaled to 3.738 = 23.68.
  The middle streak's left cap is next at 23.33. Both sit 9.3 inside the r=33
  background disc, so nothing here lands on transparency.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <group
        android:scaleX="0.8307292"
        android:scaleY="0.8307292"
        android:translateX="27.4166667"
        android:translateY="27.4166667">

        <!-- motion streaks: (9,22.5,13x5) (4,31.5,11x5) (9,40.5,13x5), r=2.5 -->
        <path
            android:fillColor="#FFB61E"
            android:fillAlpha="0.5"
            android:pathData="M11.5,22.5h8a2.5,2.5 0 0 1 0,5h-8a2.5,2.5 0 0 1 0,-5z" />
        <path
            android:fillColor="#FFB61E"
            android:fillAlpha="0.85"
            android:pathData="M6.5,31.5h6a2.5,2.5 0 0 1 0,5h-6a2.5,2.5 0 0 1 0,-5z" />
        <path
            android:fillColor="#FFB61E"
            android:fillAlpha="0.5"
            android:pathData="M11.5,40.5h8a2.5,2.5 0 0 1 0,5h-8a2.5,2.5 0 0 1 0,-5z" />

        <!-- play triangle M28,15 L56,32 L28,49, outset 4.5 with round joins -->
        <path
            android:fillColor="#1240E8"
            android:pathData="M30.34,11.15L58.34,28.15a4.5,4.5 0 0 1 0,7.7L30.34,52.85a4.5,4.5 0 0 1 -6.84,-3.85L23.5,15a4.5,4.5 0 0 1 6.84,-3.85z" />
    </group>
</vector>
