<?xml version="1.0" encoding="utf-8"?>
<!--
  Adaptive-icon foreground: the Flick mark alone on the 108-unit canvas. The
  themed icon is ic_launcher_monochrome, not this file — the launcher keeps a
  monochrome layer's alpha, and the streaks below are deliberately translucent.

  The group maps the 64-unit grid to 58 units at (54,54): p -> 0.90625p + 25. The
  mark's extreme is the triangle's right tip, vertex (56,32) plus its 4.5-unit
  outset, i.e. 21.75 + 4.08 = 25.83 from centre; the middle streak's left cap is
  next at 25.45. Both clear the 33-unit safe-zone radius, and both sit 10 units
  inside the r=36 background disc, so nothing here lands on transparency.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <group
        android:scaleX="0.90625"
        android:scaleY="0.90625"
        android:translateX="25"
        android:translateY="25">

        <!-- motion streaks: (9,22.5,13x5) (4,31.5,11x5) (9,40.5,13x5), r=2.5 -->
        <path
            android:fillColor="#FFB61E"
            android:fillAlpha="0.5"
            android:pathData="M11.5,22.5h8a2.5,2.5 0 0 1 0,5h-8a2.5,2.5 0 0 1 0,-5z" />
        <path
            android:fillColor="#FFB61E"
            android:fillAlpha="0.85"
            android:pathData="M6.5,31.5h6a2.5,2.5 0 0 1 0,5h-6a2.5,2.5 0 0 1 0,-5z" />
        <path
            android:fillColor="#FFB61E"
            android:fillAlpha="0.5"
            android:pathData="M11.5,40.5h8a2.5,2.5 0 0 1 0,5h-8a2.5,2.5 0 0 1 0,-5z" />

        <!-- play triangle M28,15 L56,32 L28,49, outset 4.5 with round joins -->
        <path
            android:fillColor="#1240E8"
            android:pathData="M30.34,11.15L58.34,28.15a4.5,4.5 0 0 1 0,7.7L30.34,52.85a4.5,4.5 0 0 1 -6.84,-3.85L23.5,15a4.5,4.5 0 0 1 6.84,-3.85z" />
    </group>
</vector>
