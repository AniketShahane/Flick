<?xml version="1.0" encoding="utf-8"?>
<!--
  Themed-icon (Android 13+) silhouette. <monochrome> used to point at
  ic_launcher_foreground, which cannot serve: the launcher keeps that layer's
  alpha and replaces its colour, so the streaks' 0.5 and 0.85 fill alphas would
  survive as ghosted bands of the theme colour instead of a solid mark.

  The bars are dropped rather than flattened: only 1.65 units separate them from
  the triangle in the full mark, a gap that reads because the two are different
  colours, so in one colour at launcher size they close into a smudge. The
  triangle alone is re-centred on (54,54) since the bars no longer balance it,
  and drawn at 1.15x the 64-unit grid — one notch above :sender's 1.1x colour
  mark — to hold the same weight without them.

  The group applies the same 0.7552083 :sender's colour mark now takes, about
  (54,54): translate 54 x (1 - 0.7552083) = 13.21875. That keeps the 1.15/1.1
  relationship through the rescale, so the tinted mark still reads at the size of
  the coloured one it stands in for. Same geometry as the :sender silhouette to
  the coordinate — one brand, one themed mark; only the colour literal differs,
  since :receiver carries no launcher colour resources.

  No disc here: the system masks and tints this layer itself, and it is that
  mask, not our r=33 disc, that bounds it. Farthest point is a rear vertex,
  19.127 from centre plus the 3.908 scaled stroke half-width = 23.03.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <group
        android:scaleX="0.7552083"
        android:scaleY="0.7552083"
        android:translateX="13.21875"
        android:translateY="13.21875">

        <path
            android:pathData="M37.9,34.45 L70.1,54 L37.9,73.55 Z"
            android:fillColor="#FF000000"
            android:strokeColor="#FF000000"
            android:strokeWidth="10.35"
            android:strokeLineJoin="round" />

    </group>
</vector>
