<?xml version="1.0" encoding="utf-8"?>
<!--
  Themed-icon (Android 13+) silhouette. <monochrome> used to point at
  ic_launcher_foreground, which cannot serve: the launcher keeps that layer's
  alpha and replaces its colour, so the streaks' 0.5 and 0.85 fill alphas would
  survive as ghosted bands of the theme colour instead of a solid mark.

  The bars are dropped rather than flattened: only 1.65 units separate them from
  the triangle in the full mark, a gap that reads because the two are different
  colours, so in one colour at launcher size they close into a smudge. The
  triangle alone is re-centred on (54,54) since the bars no longer balance it,
  and drawn at 1.15x the 64-unit grid — one notch above :sender's 1.1x colour
  mark — to hold the same weight without them.

  Its source painted bounds are 42.55 x 49.45 units including the round stroke.
  The group scale is 48 / 49.45 = 0.97067745, giving a 41.30 x 48.00 themed
  mark. Scaling about (54,54) requires 54 x (1 - 0.97067745) = 1.5834177
  translation on both axes, matching :sender's themed layer to the coordinate.

  The farthest possible painted point is 29.60 from centre, leaving 3.40 units
  inside Android's radius-33 safe zone before the system masks and re-tints it.

  The system masks and tints this layer itself; its solid alpha avoids preserving
  the colour foreground's intentionally translucent streaks as ghosted bands.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <group
        android:scaleX="0.97067745"
        android:scaleY="0.97067745"
        android:translateX="1.5834177"
        android:translateY="1.5834177">

        <path
            android:pathData="M37.9,34.45 L70.1,54 L37.9,73.55 Z"
            android:fillColor="#FF000000"
            android:strokeColor="#FF000000"
            android:strokeWidth="10.35"
            android:strokeLineJoin="round" />

    </group>
</vector>
