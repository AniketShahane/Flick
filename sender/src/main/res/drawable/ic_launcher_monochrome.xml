<?xml version="1.0" encoding="utf-8"?>
<!--
  Themed-icon (Android 13+) silhouette. The speed bars are omitted: in the full
  mark only 1.65 units separate them from the triangle's stroke, a gap that reads
  because the two are different colours. Flattened to one colour and rendered at
  launcher size they close up into a smudge — the same reason FlickMark itself
  drops the bars below 24dp. The triangle alone is re-centred on (54,54) here,
  since it no longer has the bars balancing it on the left.

  The path is the 64-unit grid triangle at 1.15x, one notch above the colour
  mark's 1.1x so it carries the same weight without the bars. Its source painted
  bounds are 42.55 x 49.45 units including the round stroke. The group scale is
  48 / 49.45 = 0.97067745, giving a 41.30 x 48.00 themed mark. Scaling about
  (54,54) requires 54 x (1 - 0.97067745) = 1.5834177 translation on both axes.

  The farthest possible painted point is 29.60 from centre, leaving 3.40 units
  inside Android's radius-33 safe zone before the system masks and re-tints it.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <group
        android:scaleX="0.97067745"
        android:scaleY="0.97067745"
        android:translateX="1.5834177"
        android:translateY="1.5834177">

        <path
            android:pathData="M37.9,34.45 L70.1,54 L37.9,73.55 Z"
            android:fillColor="@color/ic_launcher_monochrome"
            android:strokeColor="@color/ic_launcher_monochrome"
            android:strokeWidth="10.35"
            android:strokeLineJoin="round" />

    </group>
</vector>
