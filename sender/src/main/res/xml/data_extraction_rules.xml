<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <!--
      Excluded from both transports for the same reason: the library scope is a MediaStore
      bucket id, an opaque hash of a folder path on the volume it was read from, and it
      names nothing on the phone it lands on — the library would open on the "that folder
      isn't there any more" card, permanently so below Q, where no row carries a bucket id
      to match against. A device transfer is still a different device. The appearance
      preference is deliberately absent from both lists: a light/dark choice is about the
      person rather than the hardware, and everything not excluded here is carried over.
    -->
    <cloud-backup>
        <exclude domain="sharedpref" path="flick_pairings.xml" />
        <exclude domain="sharedpref" path="flick_subtitles_online.xml" />
        <exclude domain="sharedpref" path="flick_library.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="flick_pairings.xml" />
        <exclude domain="sharedpref" path="flick_subtitles_online.xml" />
        <exclude domain="sharedpref" path="flick_library.xml" />
    </device-transfer>
</data-extraction-rules>
