    <!-- ===== Unplayable files & honest failures ===== -->
    <!-- ===== S3 · the tile's two honest states ===== -->
    <!-- Both render in a mono badge style, which applies no transform and is tracked:
         the copy has to arrive uppercase. "UNKNOWN" is the withheld claim (MediaStore
         told us nothing); "DIDN'T PLAY" is the remembered fact (this TV refused it),
         and it stays in the past tense because one refusal is all we ever witnessed. -->
    <string name="library_badge_unknown">UNKNOWN</string>
    <string name="library_badge_unplayable">DIDN\'T PLAY</string>
    <string name="a11y_tile_unplayable">Your TV couldn\'t play this file</string>
