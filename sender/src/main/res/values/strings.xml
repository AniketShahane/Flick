    <!-- Pairing outcome messages (mapped from a PairErrorKind, never raw exception text). -->
    <string name="pair_error_code">That code didn\'t match. Check the TV and try again.</string>
    <string name="pair_error_unreachable">Couldn\'t reach that TV.</string>
    <string name="pair_error_invalid">Enter the current host, port, and four-digit code exactly as shown on your TV.</string>
    <string name="pair_error_update">Update Flick on your TV, then try again.</string>
    <string name="pair_error_qr">This QR code cannot be used. Update Flick on both devices and scan the current TV code.</string>
    <string name="pair_error_pair_required">This TV needs pairing first. Scan its QR, then enter the host, port, and code shown on screen.</string>
    <string name="pair_error_storage">Flick couldn’t save this pairing on your phone. Check storage, then pair again with the current TV code.</string>
    <string name="pair_error_timeout">The TV didn\'t answer in time. Check both devices are on the same Wi-Fi.</string>
    <string name="pair_error_rejected">The TV refused the connection. Make sure its pairing screen is showing, then try again.</string>
    <string name="pair_error_expired">That code expired — a new one is on the TV.</string>
    <string name="pair_error_surface">Open Flick\'s pairing screen on the TV.</string>
