    <string name="settings_theme_dark">Dark</string>
    <string name="settings_theme_a11y">Appearance: %1$s</string>
    <!-- Now Playing, Connecting and the quality sheet are dark by design, not by
         preference — a light chrome around a film competes with the film. Said here so a
         viewer who picks Light and then opens the remote reads it as intent, not a bug. -->
    <string name="settings_theme_note">The remote and the connecting screen stay dark either way, so nothing competes with what\'s playing.</string>
