    <string name="library_add_videos">Add videos</string>
    <string name="library_refresh_videos">Refresh</string>
    <!-- The pill names the TV's own reported phase: a cast record outlives playback, so
         "Live" is claimed only while the TV says it is playing and a paused, ended or
         not-yet-started session reads as itself. -->
    <string name="library_live_pill">Live · %1$s</string>
    <string name="library_paused_pill">Paused · %1$s</string>
    <string name="library_buffering_pill">Buffering · %1$s</string>
    <string name="library_ready_pill">Ready · %1$s</string>
    <!-- Only "All" carries a count: a Dolby Vision verdict needs a per-file probe and a
         4K count would imply the same precision. -->
    <string name="library_filter_all">All %1$d</string>
    <string name="library_filter_dolby_vision">Dolby Vision</string>
    <string name="library_filter_4k">4K</string>
