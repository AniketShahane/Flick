    <!-- ===== Shell — settings destination & empty library ===== -->
    <string name="nav_settings">Settings</string>
    <!-- Shown ONLY after Flick's own camera read the QR — never after a deep link, which
         is demoted to a code-less prefill and lands on the manual form instead. That
         distinction is the whole security of the flow: any app can fire the URI, but only
         the in-process scanner proves a QR was physically in front of the user. The QR
         carries the code, so this card is the authorisation step and nothing is dialled
         until the primary action is pressed. The TV's name is not in the payload — it
         comes from discovery when discovery has seen it, and the body falls back to
         naming only the address rather than claiming a name Flick cannot stand behind. -->
    <string name="pair_scanned_title">Found a TV</string>
    <string name="pair_scanned_body">Pair with %1$s at %2$s?</string>
    <string name="pair_scanned_body_unknown">Pair with the TV at %1$s?</string>
    <string name="pair_scanned_action">Pair with %1$s</string>
    <string name="pair_scanned_action_unknown">Pair with this TV</string>
    <string name="pair_scanned_dismiss">Not now</string>

    <string name="settings_heading">Signal\n&amp; setup.</string>

    <!-- Appearance. "Match system" is the default because following the platform is what
         a user who has never opened this row already expects. -->
    <string name="settings_appearance_title">Appearance</string>
    <string name="settings_appearance_summary">How Flick looks on this phone</string>
    <string name="settings_theme_system">Match system</string>
