<?xml version="1.0" encoding="utf-8"?>
<!--
  minSdk is 26, so this adaptive icon covers every supported device and no PNG
  density buckets exist. <monochrome> is read only on API 33+ and ignored below.

  The background is full-bleed so each launcher can apply its native adaptive
  mask. The colour and monochrome marks stay inside Android's central 66-unit
  safe zone; the launcher masks and re-tints the monochrome layer itself.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
    <monochrome android:drawable="@drawable/ic_launcher_monochrome" />
</adaptive-icon>
