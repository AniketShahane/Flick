<?xml version="1.0" encoding="utf-8"?>
<!--
  android:roundIcon target. An adaptive icon is already mask-agnostic, so this is
  deliberately identical to ic_launcher; it exists only because launchers that
  request the round variant fall back to the legacy icon when it is missing.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
    <monochrome android:drawable="@drawable/ic_launcher_monochrome" />
</adaptive-icon>
